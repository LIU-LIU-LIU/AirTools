<Window x:Class="AirTools.Tools.SystemMonitor.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统资源监控"
        Width="Auto" SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="MonitorBg" Color="#CC282828"/>
        <SolidColorBrush x:Key="MonitorBorder" Color="#404040"/>
        <SolidColorBrush x:Key="MonitorCpuColor" Color="#96FF96"/>
        <SolidColorBrush x:Key="MonitorMemColor" Color="#9696FF"/>
        <SolidColorBrush x:Key="MonitorDiskColor" Color="#FFC896"/>
        <SolidColorBrush x:Key="MonitorNetColor" Color="#FFC896"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="AccentColor" Color="#89B4FA"/>

        <!-- One metric = label · fixed-width monospaced value · activity dot, all on the same centre line. -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="30"/>
        </Style>
        <Style x:Key="MetricSpeed" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Setter Property="Width" Value="42"/>
        </Style>
        <Style x:Key="MetricDot" TargetType="Rectangle">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="RadiusX" Value="2.5"/>
            <Setter Property="RadiusY" Value="2.5"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <ContextMenu x:Key="MonitorContextMenu">
            <MenuItem Header="设置…" Click="MenuItem_Settings_Click"><MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="恢复默认位置" Click="MenuItem_ResetPosition_Click"><MenuItem.Icon><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons"/></MenuItem.Icon></MenuItem>
            <Separator/>
            <MenuItem Header="关闭监控条" Click="MenuItem_Close_Click"><MenuItem.Icon><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons"/></MenuItem.Icon></MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource MonitorBg}" BorderBrush="{DynamicResource MonitorBorder}" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="10"
            ContextMenu="{StaticResource MonitorContextMenu}" ToolTip="拖动移动（自动吸附到常用位置，按住 Shift 或 Ctrl 取消吸附）· 右键更多" Cursor="SizeAll"
            MouseLeftButtonDown="Bar_MouseLeftButtonDown" MouseMove="Bar_MouseMove" MouseLeftButtonUp="Bar_MouseLeftButtonUp" LostMouseCapture="Bar_LostMouseCapture">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3"/></Border.Effect>
        <Grid>
            <!-- Horizontal layout: one row, everything centred on the same line -->
            <StackPanel x:Name="PanelHorizontal" Orientation="Horizontal" Visibility="Visible" VerticalAlignment="Center">
                <StackPanel x:Name="GridCpuH" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TxtCpuH" Text="100%" Style="{StaticResource MetricValue}" Foreground="{DynamicResource MonitorCpuColor}"/>
                </StackPanel>
                <StackPanel x:Name="GridMemH" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TxtMemH" Text="100%" Style="{StaticResource MetricValue}" Foreground="{DynamicResource MonitorMemColor}"/>
                </StackPanel>
                <StackPanel x:Name="GridDiskH" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="磁盘" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TxtDiskH" Text="999.9M" Style="{StaticResource MetricSpeed}" Foreground="{DynamicResource MonitorDiskColor}"/>
                    <Rectangle x:Name="DiskLineH" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorDiskColor}" Opacity="0.3"/>
                </StackPanel>
                <StackPanel x:Name="PanelNetH" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↑" Style="{StaticResource MetricLabel}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtNetUpH" Text="999.9M" Style="{StaticResource MetricSpeed}" Foreground="{DynamicResource MonitorNetColor}"/>
                    <Rectangle x:Name="NetUpLineH" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorNetColor}" Opacity="0.3" Margin="3,0,8,0"/>
                    <TextBlock Text="↓" Style="{StaticResource MetricLabel}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtNetDownH" Text="999.9M" Style="{StaticResource MetricSpeed}" Foreground="{DynamicResource MonitorNetColor}"/>
                    <Rectangle x:Name="NetDownLineH" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorNetColor}" Opacity="0.3"/>
                </StackPanel>
            </StackPanel>

            <!-- Vertical layout: the same three columns (label / value / dot) on every row so nothing drifts -->
            <StackPanel x:Name="PanelVertical" Visibility="Collapsed">
                <Grid x:Name="GridCpuV" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="42"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" Margin="0"/>
                    <TextBlock x:Name="TxtCpuV" Grid.Column="1" Text="100%" Style="{StaticResource MetricValue}" Width="Auto" Foreground="{DynamicResource MonitorCpuColor}"/>
                    <Rectangle x:Name="CpuLineV" Grid.Column="2" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorCpuColor}" Opacity="0" HorizontalAlignment="Right"/>
                </Grid>
                <Grid x:Name="GridMemV" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="42"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                    <TextBlock Text="RAM" Style="{StaticResource MetricLabel}" Margin="0"/>
                    <TextBlock x:Name="TxtMemV" Grid.Column="1" Text="100%" Style="{StaticResource MetricValue}" Width="Auto" Foreground="{DynamicResource MonitorMemColor}"/>
                    <Rectangle x:Name="MemLineV" Grid.Column="2" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorMemColor}" Opacity="0" HorizontalAlignment="Right"/>
                </Grid>
                <Grid x:Name="GridDiskV" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="42"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                    <TextBlock Text="磁盘" Style="{StaticResource MetricLabel}" Margin="0"/>
                    <TextBlock x:Name="TxtDiskV" Grid.Column="1" Text="999.9M" Style="{StaticResource MetricValue}" Width="Auto" Foreground="{DynamicResource MonitorDiskColor}"/>
                    <Rectangle x:Name="DiskLineV" Grid.Column="2" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorDiskColor}" Opacity="0.3" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel x:Name="PanelNetV">
                    <Grid x:Name="GridNetUpV" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="42"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                        <TextBlock Text="上传" Style="{StaticResource MetricLabel}" Margin="0"/>
                        <TextBlock x:Name="TxtNetUpV" Grid.Column="1" Text="999.9M" Style="{StaticResource MetricValue}" Width="Auto" Foreground="{DynamicResource MonitorNetColor}"/>
                        <Rectangle x:Name="NetUpLineV" Grid.Column="2" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorNetColor}" Opacity="0.3" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="GridNetDownV">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="42"/><ColumnDefinition Width="9"/></Grid.ColumnDefinitions>
                        <TextBlock Text="下载" Style="{StaticResource MetricLabel}" Margin="0"/>
                        <TextBlock x:Name="TxtNetDownV" Grid.Column="1" Text="999.9M" Style="{StaticResource MetricValue}" Width="Auto" Foreground="{DynamicResource MonitorNetColor}"/>
                        <Rectangle x:Name="NetDownLineV" Grid.Column="2" Style="{StaticResource MetricDot}" Fill="{DynamicResource MonitorNetColor}" Opacity="0.3" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
