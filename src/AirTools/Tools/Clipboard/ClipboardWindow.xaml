<ui:FluentWindow x:Class="AirTools.Tools.Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AirTools.Tools.Clipboard.Models"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="剪切板历史"
        Width="620" Height="760"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ExtendsContentIntoTitleBar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter chip: a pill that fills with the accent colour when checked. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" Padding="14,5,14,6" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AirTools · 剪切板历史" Height="44"/>

        <!-- Header: title, count, actions -->
        <DockPanel Grid.Row="1" Margin="24,6,20,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Transparent" Click="BtnClear_Click" ToolTip="清除所有未置顶的记录" Padding="10,6" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="清理"/></StackPanel>
                </ui:Button>
                <ui:Button Appearance="Transparent" Click="BtnSettings_Click" ToolTip="设置" Padding="8,6"><ui:SymbolIcon Symbol="Settings24" FontSize="16"/></ui:Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="剪切板历史" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="TxtCount" Text="共 0 条" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Search + filter chips -->
        <StackPanel Grid.Row="2" Margin="24,0,24,10">
            <Grid>
                <ui:TextBox x:Name="TxtSearch" PlaceholderText="搜索剪切板内容…  (Ctrl+F)" PlaceholderEnabled="True" TextChanged="TxtSearch_TextChanged" Padding="38,8,10,8" FontSize="13.5"/>
                <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="SearchPlaceholder" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton x:Name="BtnShowAll" Content="全部" Style="{StaticResource Chip}" GroupName="filter" IsChecked="True" Click="BtnShowAll_Click"/>
                <RadioButton x:Name="BtnShowPinned" Content="置顶" Style="{StaticResource Chip}" GroupName="filter" Click="BtnShowPinned_Click"/>
                <RadioButton x:Name="BtnShowText" Content="文本" Style="{StaticResource Chip}" GroupName="filter" Click="BtnShowText_Click"/>
                <RadioButton x:Name="BtnShowImage" Content="图片" Style="{StaticResource Chip}" GroupName="filter" Click="BtnShowImage_Click"/>
                <RadioButton x:Name="BtnShowFiles" Content="文件" Style="{StaticResource Chip}" GroupName="filter" Click="BtnShowFiles_Click"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="LstClipboard" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                 Margin="16,0,16,0" Padding="0,0,0,12" MouseDoubleClick="LstClipboard_MouseDoubleClick" SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Margin="8,3">
                                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" Padding="14,11,8,11"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <!-- Accent rail for the selected row, like Fluent list selection. -->
                                    <Border x:Name="Rail" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}" Opacity="0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                        <Setter TargetName="Rail" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="Row" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Type badge -->
                        <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" Margin="0,1,12,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="TypeGlyph" Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Preview" Text="{Binding PreviewText}" FontSize="13" TextWrapping="Wrap" MaxHeight="58" LineHeight="19"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="Thumb" CornerRadius="6" Visibility="Collapsed" HorizontalAlignment="Left" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Image Source="{Binding ImageThumbnail}" MaxHeight="128" MaxWidth="300" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,1,5,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding TimeDisplay}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="  ·  " FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Row actions: revealed on hover / selection so the list stays calm. -->
                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0" Opacity="0">
                            <Button Style="{StaticResource RowButton}" ToolTip="复制" Tag="{Binding}" Click="BtnCopy_Click"><ui:SymbolIcon Symbol="Copy20"/></Button>
                            <Button Style="{StaticResource RowButton}" ToolTip="置顶 / 取消置顶" Tag="{Binding}" Click="BtnPin_Click"><ui:SymbolIcon Symbol="Pin20"/></Button>
                            <Button Style="{StaticResource RowButton}" ToolTip="删除 (Delete)" Tag="{Binding}" Click="BtnDelete_Click"><ui:SymbolIcon Symbol="Delete20"/></Button>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ItemType}" Value="{x:Static models:ClipboardItemType.Image}">
                            <Setter TargetName="Preview" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TypeGlyph" Property="Text" Value="&#xE91B;"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="{x:Static models:ClipboardItemType.Files}">
                            <Setter TargetName="TypeGlyph" Property="Text" Value="&#xE8B7;"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter TargetName="TypeGlyph" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,60">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="32" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="还没有剪切板历史" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyBody" Text="复制文本、图片或文件后会出现在这里" FontSize="12.5" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Footer: status + keyboard hints -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="24,9,24,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="双击 粘贴  ·  Enter 复制  ·  Del 删除  ·  Esc 关闭" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
