<ui:FluentWindow x:Class="AirTools.LauncherWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="AirTools 搜索" Width="700" Height="490" MinWidth="420"
 FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 Background="Transparent" WindowCornerPreference="Round"
 WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True"
 PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
 <Border CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource SoftBorder}" Background="{DynamicResource LauncherSurface}" Padding="18,14,18,12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="6,0,2,12" LastChildFill="False">
    <TextBlock Text="Air Tools" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
    <Button Content="⚙" ToolTip="设置与快速启动" DockPanel.Dock="Right" Click="Settings_Click" Padding="8,3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}"/>
   </DockPanel>
   <Border Grid.Row="1" CornerRadius="14" Background="{DynamicResource SearchSurface}" BorderBrush="{DynamicResource SoftBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
    <DockPanel>
     <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource TextDim}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Border x:Name="ModeBadge" Background="{DynamicResource SelectionSurface}" CornerRadius="8" Padding="8,4" Margin="0,0,10,0" Visibility="Collapsed"><TextBlock x:Name="ModeText" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/></Border>
     <Grid>
      <TextBox x:Name="Query" FontSize="18" BorderThickness="0" Padding="0,3" Background="Transparent" Foreground="{DynamicResource TextPrimary}" TextChanged="Query_TextChanged">
       <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template>
      </TextBox>
      <TextBlock x:Name="SearchPlaceholder" FontSize="15" Foreground="{DynamicResource TextDim}" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </DockPanel>
   </Border>
   <Grid Grid.Row="2">
    <ListBox x:Name="Results" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Results_DoubleClick">
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,2"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Card" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SearchSurface}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectionSurface}"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><DockPanel>
      <TextBlock Text="{Binding Icon}" FontSize="21" Width="38" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}"/>
      <StackPanel><TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
     </DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Empty" Text="没有匹配结果" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="Hint" FontSize="11" Foreground="{DynamicResource TextDim}" Margin="8,10,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Border>
</ui:FluentWindow>
